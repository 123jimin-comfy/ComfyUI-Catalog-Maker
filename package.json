{
  "name": "comfyui-catalog-maker",
  "type": "module",
  "version": "0.0.1",
  "description": "A tool for creating and updating sample images for T2I (text-to-image) models.",
  "bin": {
    "make-comfy-catalog": "dist/bin/main.js"
  },
  "scripts": {
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "prepare": "pnpm build",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "lint": "eslint src/",
    "pretest": "pnpm build",
    "test": "node --test \"dist/**/*.spec.js\"",
    "start": "node dist/bin/main.js"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@10.7.1",
  "dependencies": {
    "@stable-canvas/comfyui-client": "^1.5.9",
    "argparse": "^3.0.1",
    "toml": "^5.0.0",
    "ws": "^8.21.3",
    "arktype": "2.2.3",
    "sharp": "0.35.4"
  },
  "files": [
    "dist",
    "!dist/**/*.spec.*"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@jiminp/eslint-config": "^1.3.7",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.4.1",
    "eslint": "^10.9.1",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.62.1",
    "@types/ws": "8.18.1"
  }
}
